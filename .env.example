# Modelo de variáveis de ambiente.
# Copie para .env e ajuste conforme necessário:  cp .env.example .env
# O arquivo .env NÃO é versionado (ver .gitignore).

# ---- Banco de dados (docker-compose e aplicação no perfil dev) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexo
DB_USERNAME=nexo
DB_PASSWORD=nexo

# ---- Aplicação ----
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ---- CORS (origens do frontend, separadas por vírgula) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Autenticação JWT ----
# Em dev, deixe JWT_SECRET ausente para usar a chave local configurada no perfil.
# Fora de dev/test, configure JWT_SECRET no ambiente do processo (mínimo 32 caracteres).
# JWT_SECRET=
JWT_ISSUER=nexo-api
JWT_EXPIRATION=PT2H

# ---- Documentos (upload da tela de Conhecimento) ----
# Só PDF, DOCX, TXT e MD; o binário fica fora do banco.
DOCUMENTOS_TAMANHO_MAXIMO=10MB
ARMAZENAMENTO_TIPO=local
ARMAZENAMENTO_DIRETORIO=./data/arquivos

# ---- Notificações ----
# Antecedência do aviso de prazo próximo e retenção das notificações lidas.
NOTIFICACAO_DIAS_PRAZO=3
NOTIFICACAO_RETENCAO_LIDAS=P90D

# ---- Recuperação de senha e e-mail ----
# Em dev, EMAIL_ENVIADOR=registro grava cada e-mail em ./data/emails.
FRONT_URL=http://localhost:5173
SENHA_TOKEN_VALIDADE=PT30M
SENHA_LIMITE_PEDIDOS=3
SENHA_JANELA_PEDIDOS=PT15M
# EMAIL_ENVIADOR=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_REMETENTE=nao-responda@nexo.com.br
