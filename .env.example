# Modelo de variáveis de ambiente.
# Copie para .env e ajuste conforme necessário:  cp .env.example .env
# O arquivo .env NÃO é versionado (ver .gitignore).

# ---- Banco de dados (docker-compose e aplicação no perfil dev) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexo
DB_USERNAME=nexo
DB_PASSWORD=nexo

# ---- Aplicação ----
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ---- CORS (origens do frontend, separadas por vírgula) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
