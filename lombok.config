# Raiz da configuração do Lombok deste repositório.
config.stopBubbling = true

# Marca o código gerado com @lombok.Generated, para ferramentas de cobertura
# ignorarem getters/construtores criados pelas anotações.
lombok.addLombokGeneratedAnnotation = true

# Anotações do Spring que o Lombok copia dos campos para os parâmetros do
# construtor gerado — é o que faz @RequiredArgsConstructor conviver com
# injeção por @Value/@Qualifier.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
