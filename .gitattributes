# Normaliza fim de linha: LF no repositório para todo texto.
* text=auto eol=lf

# Scripts específicos de plataforma
*.cmd  text eol=crlf
*.bat  text eol=crlf
mvnw   text eol=lf

# Tipos de texto do projeto
*.java text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.xml  text eol=lf
*.md   text eol=lf

# Binários
*.jar  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
